# Any OpenAI-compatible endpoint.
#   OpenAI:  leave LLM_BASE_URL empty, set OPENAI_API_KEY
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:7b-instruct
#   vLLM:    LLM_BASE_URL=http://<host>:8000/v1       LLM_MODEL=<served model name>
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Retrieval models (optional overrides)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
